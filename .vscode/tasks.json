{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FishStop: avvia app desktop",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "tauri", "--", "dev"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:USERPROFILE}\\.cargo\\bin;${env:PATH}"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "FishStop: build frontend",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "FishStop: test Python",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "unittest", "discover", "-s", "src-python\\tests", "-v"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}\\src-python"
        }
      },
      "problemMatcher": []
    }
  ]
}
