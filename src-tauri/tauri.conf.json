{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FishStop",
  "version": "0.1.0",
  "identifier": "it.fishstop.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "FishStop", "width": 1120, "height": 720, "minWidth": 760, "minHeight": 560, "resizable": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/fishstop-engine"],
    "resources": ["resources/ollama"]
  }
}
